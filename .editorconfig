# Réglages communs des éditeurs : UTF-8, fins de ligne LF, indentation de 2 espaces.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
